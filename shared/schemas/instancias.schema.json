{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EdwinKestler/Gaussian-Splatting-WebViewers/shared/schemas/instancias.schema.json",
  "title": "instancias.json",
  "description": "Instancias por gaussiana (plan §3.3). El índice de la gaussiana en el archivo fuente es el identificador invariante; las etiquetas van en etiquetas.u32 (N × uint32, 0 = fondo) y las ediciones en ops.jsonl.",
  "type": "object",
  "required": ["version", "escena", "fecha", "fuente", "metodo", "n_instancias", "instancias"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "escena": { "type": "string" },
    "fecha": { "type": "string" },
    "fuente": {
      "type": "object",
      "required": ["n_gaussianas"],
      "properties": {
        "formato": { "type": "string" },
        "n_gaussianas": { "type": "integer", "minimum": 0 },
        "sh_grado": { "type": "integer", "minimum": 0, "maximum": 3 },
        "hash": { "type": ["string", "null"] }
      }
    },
    "metodo": {
      "type": "object",
      "required": ["mascaras", "levantamiento"],
      "properties": {
        "mascaras": { "type": "string", "description": "prueba | sidecar-cajas | sidecar-sam | sam2 | manual | …" },
        "levantamiento": { "type": "string" },
        "asociacion": { "type": ["string", "null"] },
        "sesgo_fondo": { "type": ["number", "null"] },
        "umbral_iou": { "type": ["number", "null"] },
        "umbral_gaussiana": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "difusion_iter": { "type": ["integer", "null"] },
        "vistas": { "type": ["integer", "null"] },
        "k_buffer": { "type": ["integer", "null"] }
      }
    },
    "n_instancias": { "type": "integer", "minimum": 0 },
    "embeddings": {
      "type": ["object", "null"],
      "required": ["modelo", "dimension"],
      "properties": { "modelo": { "type": "string" }, "dimension": { "type": "integer", "minimum": 0 } }
    },
    "instancias": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id_instancia", "nombre_es", "n_gaussianas"],
        "properties": {
          "id_instancia": { "type": "integer", "minimum": 1 },
          "nombre": { "type": "string" },
          "nombre_es": { "type": "string" },
          "categoria": { "type": "string" },
          "confianza": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "n_gaussianas": { "type": "integer", "minimum": 0 },
          "bbox": {
            "type": ["object", "null"],
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "max": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
            }
          },
          "color": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "vistas": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "malla": { "type": ["string", "null"], "description": "ruta relativa del GLB en artifacts/mallas/" },
          "embedding_clip": { "type": ["array", "null"], "items": { "type": "number" } }
        }
      }
    }
  }
}
