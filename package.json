{
  "name": "gaussian-splatting-webviewers",
  "version": "0.1.0",
  "private": true,
  "description": "Visores web de Gaussian Splatting (WebGL/WebGPU) con pruebas unitarias en Node y pruebas e2e en Chromium WebGPU.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:pages": "bash ./scripts/build-pages.sh",
    "test": "node --test \"tests/unit/**/*.test.?(c|m)js\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "serve": "python3 -m http.server 8090 --bind 127.0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
